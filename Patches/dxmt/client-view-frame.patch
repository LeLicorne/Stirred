+/* DXMT: keep the Metal view on the window's client area (frame in screen coordinates, like the views Wine creates itself). */
+static void dxmt_sync_client_view(struct macdrv_win_data *data)
+{
+    if (data->client_view && data->dxmt_view)
+        macdrv_set_view_frame(data->client_view, cgrect_from_rect(data->rects.client));
+}
