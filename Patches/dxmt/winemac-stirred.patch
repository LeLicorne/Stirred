+/* DXMT: keep the Metal view on the window's client area when the window is resized. */
+static CGRect dxmt_client_view_frame(struct macdrv_win_data *data)
+{
+    /* The Cocoa content view is the client area (macOS draws the title bar outside it), so the view starts at its
+       origin; only the size follows the client rect, which is in screen coordinates. */
+    RECT rect = data->rects.client;
+    OffsetRect(&rect, -rect.left, -rect.top);
+    return cgrect_from_rect(rect);
+}
+
+static void dxmt_sync_client_view(struct macdrv_win_data *data)
+{
+    if (data->client_view && data->dxmt_view)
+        macdrv_set_view_frame(data->client_view, dxmt_client_view_frame(data));
+}
